{
  "schemaVersion": 1,
  "id": "com.otzaria-alonim.qa",
  "name": "עלוני שבת QA",
  "version": "0.1.0",
  "description": "עלוני שבת מכמה אתרים במקום אחד: חיפוש מיידי, סדרות, מעקב, קריאה בצפיין פנימי, הורדה והדפסה, גם בלי רשת.",
  "author": "מיכאלוש",
  "homepage": "https://github.com/mmichaelush/otzaria-alonim-plugin",
  "stability": "beta",
  "entrypoint": "index.html",
  "icon": "icon/icon.png",
  "minAppVersion": "0.9.98",
  "sdkVersion": "1.x",
  "permissions": [
    "network.localhost",
    "fs.user_files.read",
    "app.open_url",
    "library.refresh",
    "library.books.read",
    "reader.open"
  ],
  "network": {
    "enabled": true,
    "allowlist": [
      "127.0.0.1"
    ]
  },
  "contributes": {
    "toolTab": {
      "title": "עלוני שבת QA",
      "order": 100,
      "allowOrderBeforeBuiltIns": false,
      "defaultPinned": true,
      "iconName": "news_24_regular"
    }
  }
}