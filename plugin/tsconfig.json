{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["types.d.ts", "js/**/*.js"],
  "exclude": ["js/alonim-icons.js"]
}
